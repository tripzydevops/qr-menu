datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  output          = "../frontend/node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

model Organization {
  id                  String   @id @default(uuid())
  name                String
  logoUrl             String?
  brandColor          String?
  subscriptionTier    String?  @default("free")
  status              String   @default("active") // "active", "suspended", "onboarding"
  premiumMenuEnabled  Boolean  @default(false)
  premiumMenuSelected Boolean  @default(false)
  kdsEnabled          Boolean  @default(false)
  printingEnabled     Boolean  @default(false)
  inventoryEnabled    Boolean  @default(false)
  sharedInventory     Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  venues              Venue[]
  users               User[]
}

model Venue {
  id               String       @id @default(uuid())
  name             String
  address          String?
  coverImageUrl    String?
  phone            String?
  operatingHours   Json?
  currency         String       @default("TRY")
  defaultLocale    String       @default("tr")
  supportedLocales String[]     @default(["tr", "en"])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tables           Table[]
  categories       Category[]
  menus            Menu[]
  staff            VenueStaff[]
  orders           Order[]
  waiterRequests   WaiterRequest[]
  payments         Payment[]
  coupons          Coupon[]
  loyaltyAccounts  LoyaltyAccount[]
  ingredients      Ingredient[]
  suppliers        Supplier[]
  invoices         Invoice[]
  pricingAlerts    PricingAlert[]
  pricingAlertRule PricingAlertRule?
  reviewsEnabled   Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Table {
  id        String   @id @default(uuid())
  name      String   // e.g. "Table 1", "Room 304", "Poolside Cabana 2"
  areaName  String?  // e.g. "Terrace", "Indoor", "Pool"
  qrToken   String   @unique // The unique token in the QR code url
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  orders    Order[]
  waiterRequests WaiterRequest[]
  payments  Payment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String                @id @default(uuid())
  nameTr       String                // Turkish category name (fallback)
  nameEn       String                // English category name (fallback)
  iconName     String?
  sortOrder    Int                   @default(0)
  venueId      String
  venue        Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuId       String?
  menu         Menu?                 @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([venueId])
}

model MenuItem {
  id            String                @id @default(uuid())
  nameTr        String                // Fallback
  nameEn        String                // Fallback
  descriptionTr String?               // Fallback
  descriptionEn String?               // Fallback
  price         Decimal               // TRY price
  imageUrl      String?
  allergens     String[]              // e.g. ["gluten", "nuts", "dairy"]
  isAvailable   Boolean               @default(true)
  showOnMenu    Boolean               @default(true)
  isDeleted     Boolean               @default(false)
  sortOrder     Int                   @default(0)
  calories      Int?
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dietaryLabels DietaryLabel[]        @relation("MenuItemToDietaryLabel")
  translations  MenuItemTranslation[]
  orderItems    OrderItem[]
  recipe        Recipe?
  pricingAlerts PricingAlert[]
  embedding     Unsupported("vector(768)")?
  reviews       Review[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([categoryId])
}

model MenuItemTranslation {
  id          String   @id @default(uuid())
  locale      String   // "tr", "en", "de", "ru", "ar"
  name        String
  description String?
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([menuItemId, locale])
}

model CategoryTranslation {
  id         String   @id @default(uuid())
  locale     String   // "tr", "en", "de", "ru", "ar"
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locale])
}

model DietaryLabel {
  id        String     @id @default(uuid())
  key       String     @unique // "vegan", "halal", "gluten-free"
  icon      String?    // emoji or icon name
  items     MenuItem[] @relation("MenuItemToDietaryLabel")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Menu {
  id         String         @id @default(uuid())
  name       String         // "Breakfast Menu", "Summer Cocktails"
  venueId    String
  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  categories Category[]
  schedules  MenuSchedule[]
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model MenuSchedule {
  id        String    @id @default(uuid())
  menuId    String
  menu      Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dayOfWeek Int?      // 0=Sunday, 6=Saturday, null=every day
  startTime String?   // "06:00"
  endTime   String?   // "11:00"
  startDate DateTime? // for seasonal menus
  endDate   DateTime? // for seasonal menus
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  venueId   String
  tableId   String?
  locale    String?
  path      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([venueId])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  VENUE_MANAGER
}

model User {
  id             String       @id // Matches Supabase auth.users.id
  email          String       @unique
  firstName      String?
  lastName       String?
  role           UserRole     @default(VENUE_MANAGER)
  organizationId String?      // Null for SUPER_ADMIN
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venues         VenueStaff[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model VenueStaff {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, venueId])
}

model SystemSetting {
  key   String @id
  value String
}

model Order {
  id            String      @id @default(uuid())
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  status        String      @default("pending") // "pending", "preparing", "completed", "cancelled"
  totalAmount     Decimal
  discountAmount  Decimal     @default(0.00)
  discountType    String?     // "COUPON", "LOYALTY", "MANUAL"
  discountRef     String?     // coupon code, loyalty phone, or staff ID
  netAmount       Decimal     @default(0.00)
  paymentMethod   String?     // "cash", "card", "online"
  paidAt          DateTime?
  items           OrderItem[]
  isArchived      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([venueId])
  @@index([tableId])
  @@index([isArchived])
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity   Int
  price      Decimal
  notes      String?

  @@index([orderId])
  @@index([menuItemId])
}

model WaiterRequest {
  id        String   @id @default(uuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type      String   // "waiter", "bill"
  status    String   @default("pending") // "pending", "completed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            String      @id @default(uuid())
  venueId       String
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  amount        Decimal
  paymentMethod String      // "cash", "card"
  splitMode     String      @default("full")  // "full", "equal", "by_item", "by_amount"
  label         String?     // e.g. "Kişi 1", "Ali"
  orderIds      String[]
  orderItemIds  String[]    @default([])
  createdAt     DateTime    @default(now())

  @@index([venueId])
  @@index([tableId])
}

model UserSignal {
  id        String   @id @default(uuid())
  sessionId String
  venueId   String
  tableId   String?
  eventType String   // "view_item", "expand_item", "filter_dietary", "scroll_category", "add_to_cart"
  eventData Json     // e.g. { "itemId": "item-1", "durationMs": 4500 }
  createdAt DateTime @default(now())

  @@index([venueId])
  @@index([sessionId])
  @@index([createdAt])
}

// =============================================
// INVENTORY COSTING & RECIPE ENGINE
// =============================================

model Ingredient {
  id             String             @id @default(uuid())
  name           String
  unit           String             // "g", "ml", "unit", "kg", "liter"
  currentStock   Decimal            @default(0)
  reorderLevel   Decimal?           // Alert when stock falls below this
  weightedCost   Decimal            @default(0) // Weighted Average Cost per unit
  density        Decimal            @default(1.0) @db.Decimal(14, 4)
  lastBrand      String?
  venueId        String
  venue          Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  organizationId String?            // Used when sharedInventory=true
  invoiceItems   InvoiceItem[]
  recipeItems    RecipeIngredient[]
  costHistory    IngredientCostLog[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([venueId])
  @@index([organizationId])
}

model Supplier {
  id             String     @id @default(uuid())
  name           String
  contactEmail   String?
  contactPhone   String?
  venueId        String
  venue          Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  invoices       Invoice[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([venueId])
}

model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String?
  supplierId     String
  supplier       Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  invoiceDate    DateTime
  totalAmount    Decimal
  status         String        @default("pending") // "pending", "processed", "void"
  venueId        String
  venue          Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items          InvoiceItem[]
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([venueId])
  @@index([supplierId])
  @@index([isArchived])
}

model InvoiceItem {
  id             String     @id @default(uuid())
  invoiceId      String
  invoice        Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity       Decimal
  unitCost       Decimal
  vatRate        Decimal    @default(0.01) // e.g. 0.01 (1%), 0.10 (10%), 0.20 (20%)
  isVatInclusive Boolean    @default(false)
  totalCost      Decimal
  rawName        String?
  brand          String?

  @@index([invoiceId])
  @@index([ingredientId])
}

model Recipe {
  id             String             @id @default(uuid())
  menuItemId     String             @unique
  menuItem       MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  targetMargin   Decimal            @default(0.70) // 70%
  yieldQuantity  Decimal            @default(1.0)  // The number of portions this recipe yields
  yieldUnit      String             @default("porsiyon")
  portionSize    Decimal            @default(1.0)
  totalYield     Decimal            @default(1.0)
  currentCost    Decimal            @default(0)    // Portion cost (Total Cost / yieldQuantity)
  isDeleted      Boolean            @default(false)
  ingredients    RecipeIngredient[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model RecipeIngredient {
  id             String     @id @default(uuid())
  recipeId       String
  recipe         Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  amountUsed     Decimal    // In the ingredient's unit (e.g. 15g, 200ml)

  @@index([recipeId])
  @@index([ingredientId])
}

model IngredientCostLog {
  id             String     @id @default(uuid())
  ingredientId   String
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  oldCost        Decimal
  newCost        Decimal
  reason         String     // "invoice", "manual_adjustment"
  createdAt      DateTime   @default(now())

  @@index([ingredientId])
}

model PricingAlert {
  id             String     @id @default(uuid())
  venueId        String
  venue          Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItemId     String
  menuItem       MenuItem   @relation(fields: [menuItemId], references: [id])
  recipeId       String
  alertType      String     // "margin_drop", "low_stock", "cost_spike"
  message        String
  currentMargin  Decimal
  targetMargin   Decimal
  suggestedPrice Decimal?
  isResolved     Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([venueId])
  @@index([menuItemId])
  @@index([recipeId])
}

model PricingAlertRule {
  id                  String   @id @default(uuid())
  venueId             String   @unique
  venue               Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  swingThreshold      Decimal  @default(0.05) // 5%
  stockDeductionMode  String   @default("manual") // "auto" or "manual"
  autoSyncEnabled     Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  rating     Int      // Rating from 1 to 5 stars
  comment    String?  // Optional written review
  guestName  String?  @default("Guest")
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Coupon {
  id                String    @id @default(uuid())
  code              String    @unique
  type              String    // "PERCENTAGE" or "FIXED"
  value             Decimal
  maxDiscountAmount Decimal?
  minSubtotal       Decimal   @default(0.00)
  isActive          Boolean   @default(true)
  usageLimit        Int?
  usageCount        Int       @default(0)
  startsAt          DateTime?
  expiresAt         DateTime?
  venueId           String
  venue             Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([venueId])
}

model LoyaltyAccount {
  id             String           @id @default(uuid())
  phone          String           @unique
  name           String?
  points         Int              @default(0)
  externalUserId String?          // For linking to tripzy.travel account
  venueId        String
  venue          Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  histories      LoyaltyHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([venueId])
}

model LoyaltyHistory {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  points           Int            // Positive for earned, negative for redeemed
  reason           String         // e.g. "Earned from Order {id}"
  createdAt        DateTime       @default(now())
}


