datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../frontend/node_modules/.prisma/client"
}

model Organization {
  id               String   @id @default(uuid())
  name             String
  logoUrl          String?
  brandColor       String?
  subscriptionTier String?  @default("free")
  status           String   @default("active") // "active", "suspended", "onboarding"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  venues           Venue[]
  users            User[]
}

model Venue {
  id               String       @id @default(uuid())
  name             String
  address          String?
  coverImageUrl    String?
  phone            String?
  operatingHours   Json?
  currency         String       @default("TRY")
  defaultLocale    String       @default("tr")
  supportedLocales String[]     @default(["tr", "en"])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tables           Table[]
  categories       Category[]
  menus            Menu[]
  staff            VenueStaff[]
  orders           Order[]
  waiterRequests   WaiterRequest[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Table {
  id        String   @id @default(uuid())
  name      String   // e.g. "Table 1", "Room 304", "Poolside Cabana 2"
  areaName  String?  // e.g. "Terrace", "Indoor", "Pool"
  qrToken   String   @unique // The unique token in the QR code url
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  orders    Order[]
  waiterRequests WaiterRequest[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String                @id @default(uuid())
  nameTr       String                // Turkish category name (fallback)
  nameEn       String                // English category name (fallback)
  iconName     String?
  sortOrder    Int                   @default(0)
  venueId      String
  venue        Venue                 @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuId       String?
  menu         Menu?                 @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items        MenuItem[]
  translations CategoryTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model MenuItem {
  id            String                @id @default(uuid())
  nameTr        String                // Fallback
  nameEn        String                // Fallback
  descriptionTr String?               // Fallback
  descriptionEn String?               // Fallback
  price         Decimal               // TRY price
  imageUrl      String?
  allergens     String[]              // e.g. ["gluten", "nuts", "dairy"]
  isAvailable   Boolean               @default(true)
  sortOrder     Int                   @default(0)
  calories      Int?
  categoryId    String
  category      Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dietaryLabels DietaryLabel[]        @relation("MenuItemToDietaryLabel")
  translations  MenuItemTranslation[]
  orderItems    OrderItem[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model MenuItemTranslation {
  id          String   @id @default(uuid())
  locale      String   // "tr", "en", "de", "ru", "ar"
  name        String
  description String?
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([menuItemId, locale])
}

model CategoryTranslation {
  id         String   @id @default(uuid())
  locale     String   // "tr", "en", "de", "ru", "ar"
  name       String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, locale])
}

model DietaryLabel {
  id        String     @id @default(uuid())
  key       String     @unique // "vegan", "halal", "gluten-free"
  icon      String?    // emoji or icon name
  items     MenuItem[] @relation("MenuItemToDietaryLabel")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Menu {
  id         String         @id @default(uuid())
  name       String         // "Breakfast Menu", "Summer Cocktails"
  venueId    String
  venue      Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  categories Category[]
  schedules  MenuSchedule[]
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model MenuSchedule {
  id        String    @id @default(uuid())
  menuId    String
  menu      Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  dayOfWeek Int?      // 0=Sunday, 6=Saturday, null=every day
  startTime String?   // "06:00"
  endTime   String?   // "11:00"
  startDate DateTime? // for seasonal menus
  endDate   DateTime? // for seasonal menus
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  venueId   String
  tableId   String?
  locale    String?
  path      String?
  userAgent String?
  createdAt DateTime @default(now())
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  VENUE_MANAGER
}

model User {
  id             String       @id // Matches Supabase auth.users.id
  email          String       @unique
  firstName      String?
  lastName       String?
  role           UserRole     @default(VENUE_MANAGER)
  organizationId String?      // Null for SUPER_ADMIN
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venues         VenueStaff[]
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model VenueStaff {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, venueId])
}

model SystemSetting {
  key   String @id
  value String
}

model Order {
  id          String      @id @default(uuid())
  venueId     String
  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId     String?
  table       Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  status      String      @default("pending") // "pending", "preparing", "completed", "cancelled"
  totalAmount Decimal
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity   Int
  price      Decimal
  notes      String?
}

model WaiterRequest {
  id        String   @id @default(uuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  tableId   String
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  type      String   // "waiter", "bill"
  status    String   @default("pending") // "pending", "completed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



